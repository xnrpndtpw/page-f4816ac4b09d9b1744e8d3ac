steps h3{font-size:16.5px;color:var(--deep);margin:0 0 6px;font-weight:800}\n.steps p{margin:0;font-size:14.5px;color:var(--muted)}\n\n.faq-group{background:var(--white);border:1px solid var(--line);border-radius:26px;padding:28px 28px 8px;box-shadow:0 18px 40px rgba(10,39,66,.07);margin-bottom:22px}\n.faq-group > h3{font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber-ink);margin:0 0 20px;font-weight:800}\n.faq-items{display:grid;grid-template-columns:1fr 1fr;gap:0 34px}\n.qa{padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid #F2EDE4}\n.qa h4{font-size:15.5px;color:var(--deep);margin:0 0 7px;font-weight:700;line-height:1.6}\n.qa p{margin:0;font-size:14.5px;color:var(--muted)}\n\nfooter{background:var(--deep);color:#BFD5E6;padding:54px 0 46px}\n.foot-top{display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;align-items:baseline;margin-bottom:22px}\n.foot-brand{font-size:22px;font-weight:800;color:#FFFFFF;margin:0;letter-spacing:-.01em}\n.foot-links{display:flex;flex-wrap:wrap;gap:20px}\n.foot-links a{color:#A9C6DD;text-decoration:none;font-size:14px}\n.foot-links a:hover{color:var(--amber-soft)}\n.foot-note{margin:0;font-size:13px;line-height:1.8;color:#8FA9BE;max-width:56em}\n\n@media (max-width:900px){\n  .wrap{width:calc(100% - 36px)}\n  .hero-grid{grid-template-columns:1fr;gap:36px;padding-top:40px}\n  .plans{grid-template-columns:1fr;gap:18px}\n  .plan:nth-child(1),.plan:nth-child(2),.plan:nth-child(3){margin-top:0}\n  .grid-2{grid-template-columns:1fr}\n  .faq-items{grid-template-columns:1fr}\n  .split{grid-template-columns:1fr;gap:22px}\n  .band{padding:60px 0}\n  .fit-row{grid-template-columns:1fr;gap:4px}\n  .steps li{grid-template-columns:1fr;gap:6px;padding:20px 22px}\n  .step-no{line-height:1.4}\n  .panel{padding:24px 22px}\n}\n</style><main>\n\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <nav class=\"hero-nav\" aria-label=\"页面目录\">\n        <a href=\"#plans\">套餐与价格</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n\n      <div class=\"hero-grid\">\n        <div>\n          <p class=\"eyebrow\">机场套餐与使用整理</p>\n          <h1>小猴子机场<span class=\"h1-sub\">套餐、客户端与使用说明，一页看完。</span></h1>\n          <p class=\"lede\">三档套餐按月流量和同时在线设备数区分，从个人日常使用到团队协作都有对应档位。先确认用量，再决定付多久。</p>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"套餐速览\">\n          <p class=\"panel-title\">套餐速览</p>\n          <div class=\"stats\">\n            <div class=\"stat\"><span class=\"num\">3</span><span class=\"lab\">套餐档位</span></div>\n            <div class=\"stat\"><span class=\"num\">100GB</span><span class=\"lab\">起步月流量</span></div>\n            <div class=\"stat\"><span class=\"num\">3–20 台</span><span class=\"lab\">同时在线设备</span></div>\n            <div class=\"stat\"><span class=\"num\">月付 / 年付</span><span class=\"lab\">两种计费周期</span></div>\n          </div>\n          <p class=\"panel-note\">年付价格按十个月计价，也就是比按月付满一年少付两个月的钱。</p>\n          <a class=\"btn\" href=\"#plans\">查看套餐对比</a>\n        </aside>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"about\">\n    <div class=\"wrap split\">\n      <div>\n        <p class=\"kicker\">概览</p>\n        <h2>这页整理了什么</h2>\n      </div>\n      <div class=\"prose\">\n        <p>小猴子是一个机场服务的名称。这页把三档套餐的价格、月流量与设备数排在一起，再补上客户端配置方式和使用流程，第一次接触时可以按顺序往下看。</p>\n        <p>页面内容按公开的套餐资料整理。节点线路、可用地区、订阅规则与售后条款，请以服务方实际页面为准；本页不销售、不收款，也不提供安装包。</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band band-white\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">套餐与价格</p>\n        <h2>三档套餐，按流量和设备数递进</h2>\n        <p>月付适合先试一个月，年付适合确认线路合适之后长期使用。价格与额度见下方卡片。</p>\n      </div>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <h3 class=\"plan-name\">基础版</h3>\n          <p class=\"plan-price\">¥15<span> / 月</span></p>\n          <p class=\"plan-year\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan plan-featured\">\n          <span class=\"tag\">多数人选择</span>\n          <h3 class=\"plan-name\">旗舰版</h3>\n          <p class=\"plan-price\">¥35<span> / 月</span></p>\n          <p class=\"plan-year\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <h3 class=\"plan-name\">团队版</h3>\n          <p class=\"plan-price\">¥85<span> / 月</span></p>\n          <p class=\"plan-year\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <div class=\"fit\">\n        <div class=\"fit-row\">\n          <strong>一个人日常用</strong>\n          <p>手机加电脑共 3 台以内，看视频、刷网页、偶尔下载，基础版的 100GB 月流量和普通线路够用。</p>\n        </div>\n        <div class=\"fit-row\">\n          <strong>多设备 + 重度使用</strong>\n          <p>家里和公司都要用、同时在线设备到 5 台，或者需要全节点流媒体解锁与游戏加速，旗舰版更合适。</p>\n        </div>\n        <div class=\"fit-row\">\n          <strong>小组或团队</strong>\n          <p>十几台设备共享、每月流量需求接近 1TB，需要定制路由和固定对接人，选团队版。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">客户端</p>\n        <h2>小猴子机场客户端怎么配</h2>\n        <p>客户端是你自己准备的软件，这页不提供安装包，也不放下载地址。下面只讲配置思路。</p>\n      </div>\n\n      <div class=\"grid-2\">\n        <article class=\"card\">\n          <h3>桌面端</h3>\n          <p>Windows、macOS、Linux 上都有常见的代理类客户端，选择你熟悉的那个即可。安装后找到「订阅」或「配置」入口，把订阅链接粘贴进去。</p>\n          <p>多数客户端支持手动更新订阅，建议把它加进常用操作里。</p>\n        </article>\n\n        <article class=\"card\">\n          <h3>移动端</h3>\n          <p>iOS 与 Android 各有对应类型的客户端，导入订阅的方式与桌面端基本一致。手机端更依赖系统网络设置，导入后记得按客户端提示完成一次授权。</p>\n        </article>\n\n        <article class=\"card\">\n          <h3>订阅链接从哪来</h3>\n          <p>订阅链接由你在服务方的账号页面获取。复制时确认整行完整，不要带多余空格；这条链接等同于账号凭证，不建议转发给他人。</p>\n        </article>\n\n        <article class=\"card\">\n          <h3>四个动作的顺序</h3>\n          <p>拿到订阅链接 → 在客户端里粘贴导入 → 手动更新一次节点列表 → 选中线路并开启代理。顺序别打乱，能省掉大部分「导入了却连不上」的情况。</p>\n        </article>\n      </div>\n\n      <p class=\"note-strip\">如果导入后节点列表是空的，先检查链接是否完整、网络是否可访问，再点一次更新订阅；仍然为空，就换一个网络环境重试。</p>\n    </div>\n  </section>\n\n  <section class=\"band band-white\" id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">使用说明</p>\n        <h2>从零到能用，六步走完</h2>\n        <p>不用一次性全部记住，按顺序做完前四步，基本就能正常使用。</p>\n      </div>\n\n      <ol class=\"steps\">\n        <li>\n          <span class=\"step-no\">01</span>\n          <div>\n            <h3>先估算每月用量</h3>\n            <p>看视频、刷网页、偶尔下载，100GB 通常够一个人用一个月；多人共享或长时间在线播放，直接往上一档看。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"step-no\">02</span>\n          <div>\n            <h3>按同时在线设备数选档</h3>\n            <p>3 台以内选基础版，5 台选旗舰版，20 台选团队版。设备数上限看的是「同时在线」，不是曾经登录过多少台。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"step-no\">03</span>\n          <div>\n            <h3>决定付多久</h3>\n            <p>第一次用建议先月付，跑满一个月确认线路和速度合适，再换年付。年付按十个月计价，长期用更省。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"step-no\">04</span>\n          <div>\n            <h3>获取订阅链接</h3>\n            <p>在账号页面复制订阅链接，粘贴到客户端。这条链接不要外发，多人共用会让你更快撞到设备数上限。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"step-no\">05</span>\n          <div>\n            <h3>测试并固定线路</h3>\n            <p>逐个测一次延迟，把常用的两三条线路固定下来。频繁全线切换反而会拖慢体验。</p>\n          </div>\n        </li>\n        <li>\n          <span class=\"step-no\">06</span>\n          <div>\n            <h3>定期更新订阅</h3>\n            <p>线路列表会调整，隔一段时间手动更新一次订阅即可。旧的自定义配置可能要重新添加。</p>\n          </div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <p class=\"kicker\">常见问题</p>\n        <h2>按主题分组的问答</h2>\n        <p>分成套餐与计费、客户端与连接、使用与线路三组，先看自己卡在哪一步。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>套餐与计费</h3>\n        <div class=\"faq-items\">\n          <article class=\"qa\">\n            <h4>月付和年付差多少？</h4>\n            <p>年付按十个月计价：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，相比按月付满一年少付两个月。第一次使用建议先月付试一个月。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>三档套餐的主要差别是什么？</h4>\n            <p>两个维度：月流量（100GB / 300GB / 1000GB）和同时在线设备数（3 / 5 / 20 台）。旗舰版另外包含全节点原生流媒体解锁与 IPLC 专线游戏加速，团队版提供 VIP 高带宽节点和定制路由。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>当月流量用不完能留到下月吗？</h4>\n            <p>本页没有列出结转规则，具体请以服务方公布的条款为准。下单前在账号页面确认清楚，避免预期不一致。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>升级套餐需要重新配置客户端吗？</h4>\n            <p>通常不需要。订阅不变的情况下，升级后更新一次节点列表就能看到新线路；如果订阅链接有变更，重新粘贴导入即可。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>客户端与连接</h3>\n        <div class=\"faq-items\">\n          <article class=\"qa\">\n            <h4>这里能下载客户端吗？</h4>\n            <p>不能。本页不提供安装包、下载地址或邀请链接，客户端请从你选用项目自身的发布渠道获取，安装前确认来源可靠。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>订阅导入后没有节点怎么办？</h4>\n            <p>先确认订阅链接完整复制、前后没有空格；再手动点一次「更新订阅」；仍然为空就换网络环境重试，或检查账号状态是否正常。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>能同时登录几个客户端？</h4>\n            <p>限制的是同时在线设备数，不是客户端安装数量。基础版 3 台、旗舰版 5 台、团队版 20 台，超出后通常会挤掉最早的连接。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>换了新设备要注意什么？</h4>\n            <p>先把旧设备上不用的客户端断开，再让新设备上线。同时在线的设备越少，单个设备分到的线路资源越稳定。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>使用与线路</h3>\n        <div class=\"faq-items\">\n          <article class=\"qa\">\n            <h4>看流媒体和打游戏该选哪档？</h4>\n            <p>基础版包含基础流媒体解锁，日常观看够用；需要全节点原生解锁和 IPLC 专线游戏加速优化，选旗舰版。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>团队版适合什么情况？</h4>\n            <p>十几台设备共享、每月流量接近 1TB，并且需要企业定制路由或固定对接人时，团队版比自行拼凑多个个人套餐更好管理。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>线路列表变了要怎么处理？</h4>\n            <p>重新更新一次订阅，客户端会拉取最新列表。旧的自定义节点配置可能失效，需要时再手动加回去。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>使用中遇到问题先查哪里？</h4>\n            <p>先分清是客户端问题还是账号问题：换一台设备或换一个网络测试，能定位大部分情况。仍然无法解决，走上方的工单支持渠道。</p>\n          </article>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-top\">\n      <p class=\"foot-brand\">小猴子</p>\n      <nav class=\"foot-links\" aria-label=\"页脚目录\">\n        <a href=\"#plans\">套餐与价格</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n    <p class=\"foot-note\">本页为套餐与使用信息整理，不销售、不收款、不提供安装包。价格、流量额度、设备上限与售后规则如有调整，以服务方实际页面为准。</p>\n  </div>\n</footer>",
